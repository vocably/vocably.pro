<style>
  .search-input {
    --border-radius: 3rem;
    --height: 4rem;

    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 2px solid rgba(var(--v-color-primary-rgb), 0.45);
    border-radius: var(--border-radius);
    height: var(--height);
    background: #fff;
    transition:
      box-shadow 0.25s ease,
      border-color 0.25s ease;
    box-shadow:
      0 0 0 6px rgba(var(--v-color-primary-rgb), 0.08),
      0 4px 8px -2px rgba(16, 24, 40, 0.08),
      0 18px 36px -10px rgba(var(--v-color-primary-rgb), 0.35);

    &:hover {
      border-color: rgba(var(--v-color-primary-rgb), 0.7);
      box-shadow:
        0 0 0 6px rgba(var(--v-color-primary-rgb), 0.12),
        0 6px 12px -2px rgba(16, 24, 40, 0.1),
        0 22px 44px -10px rgba(var(--v-color-primary-rgb), 0.45);
    }

    &:has(:focus) {
      border-color: var(--v-color-primary);
      box-shadow:
        0 0 0 6px rgba(var(--v-color-primary-rgb), 0.18),
        0 6px 12px -2px rgba(16, 24, 40, 0.1),
        0 22px 44px -10px rgba(var(--v-color-primary-rgb), 0.45);
    }

    .text-input {
      flex: 1;
      padding-left: 1.75rem;
      border: none;
      font-weight: 400;
      outline: none;
      background: none;
      position: relative;
      height: var(--height);
      min-width: 0;
    }

    .submit-button {
      --size: calc(var(--height) - 0.75rem);

      flex-shrink: 0;
      background: var(--v-color-primary);
      border: none;
      border-radius: 50%;
      width: var(--size);
      height: var(--size);
      margin-right: 0.3rem;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 1.15rem;
      transition:
        transform 0.15s ease,
        filter 0.15s ease;

      &:hover {
        filter: brightness(1.1);
        transform: scale(1.05);
      }

      &:focus-visible {
        outline: auto;
        outline-color: Highlight;
        outline-color: -webkit-focus-ring-color;
      }
    }

    @media (max-width: 600px) {
      gap: 0.1rem;

      .text-input {
        padding-left: 1.25rem;
      }

      .submit-button {
        --size: calc(var(--height) - 1rem);
        margin-right: 0.25rem;
      }
    }
  }

  /* A single soft pill split into two halves, each with a caption
     ("I study" / "I speak") above the chosen language. It's borderless and
     shares the search bar's rounding, so it reads as part of the search bar
     rather than as more boxes stacked on top of it. Each half is a tap
     target, and the height doesn't depend on the language names. */
  .search-form-languages {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0 0 1.5rem;
    padding: 0.25rem;
    background: rgba(var(--v-color-primary-rgb), 0.06);
    border-radius: 3rem;
    font-size: 0.8rem;
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: rgba(var(--v-color-body-rgb), 0.7);
    text-align: left;
    transition: opacity 0.2s ease;

    /* Hidden (space still reserved) until the language selects are
       rendered; index.ts adds .ready. */
    &:not(.ready) {
      visibility: hidden;
      opacity: 0;
    }

    .clause {
      position: relative;
      display: block;
      min-width: 0;
      /* Keeps the hover/open highlight clear of the divider. */
      --gap: 2px;
      margin: 0 var(--gap) 0 0;
      padding: 0.5rem 1.25rem 0.55rem 1.5rem;
      /* Round on the outer side, flatter where the two halves meet. */
      --outer-radius: 3rem;
      --inner-radius: 0.5rem;
      --radius: var(--outer-radius) var(--inner-radius) var(--inner-radius)
        var(--outer-radius);
      border-radius: var(--radius);
      transition: background-color 0.2s ease;

      & + .clause {
        margin: 0 0 0 var(--gap);
        --radius: var(--inner-radius) var(--outer-radius) var(--outer-radius)
          var(--inner-radius);
      }

      &:hover,
      &:has(vocably-filter-select.open) {
        background: rgba(var(--v-color-primary-rgb), 0.08);
      }

      /* Divider between the halves. */
      & + .clause::before {
        content: '';
        position: absolute;
        left: calc(-1 * var(--gap) - 0.5px);
        top: 25%;
        bottom: 25%;
        border-left: 1px solid rgba(var(--v-color-primary-rgb), 0.18);
      }
    }

    /* The label is plain text in the light DOM, so the field is laid out the
       same before, during and after the select's upgrade; the select's
       (empty) trigger button is stretched over the whole half (positioned
       against .clause) to handle the clicks. */
    .language-selector {
      display: flex;
      align-items: center;
      margin-top: 0.1rem;
      font-size: 1.1rem;
      font-weight: 600;
      letter-spacing: normal;
      color: var(--v-color-primary);

      vocably-filter-select {
        position: absolute;
        inset: 0;
        display: block;

        &::part(trigger) {
          border-radius: var(--radius);
        }

        &::part(trigger):focus-visible {
          outline-offset: 0;
        }
      }

      /* Shrinks (with an ellipsis) but doesn't grow, so the chevron stays
         right next to the language name. */
      .label-text {
        flex: 0 1 auto;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .chevron {
        flex-shrink: 0;
        width: 0.6em;
        height: 0.6em;
        margin-left: 0.3em;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.75;
        stroke-linecap: round;
        stroke-linejoin: round;
        transition: transform 0.2s ease;
      }
    }

    .clause:hover .chevron {
      transform: translateY(1px);
    }

    .clause:has(vocably-filter-select.open) .chevron {
      transform: rotate(180deg);
    }

    @media (max-width: 600px) {
      margin: 0 0.5rem 1.25rem;
      padding: 0.2rem;
      font-size: 0.75rem;

      .clause {
        padding: 0.4rem 1rem 0.45rem 1.25rem;
      }

      .language-selector {
        font-size: 1rem;
      }
    }
  }

  .search-form-hint {
    margin-top: 0.5rem;
    margin-left: 1.8rem;
    margin-right: 1.8rem;
    font-size: 80%;
    text-align: right;

    button {
      font-size: inherit;
      background: none;
      border: none;
      cursor: pointer;
      padding: 0;
      margin: 0;
      color: inherit;
      font-weight: inherit;
      text-decoration: underline;
      text-decoration-style: dashed;
      text-decoration-thickness: 1px;
      text-underline-offset: 2px;
    }
  }
</style>
{{#if sourceLanguage}}
  <script type='text/javascript'>
    window['searchFormSourceLanguage'] = '{{sourceLanguage}}';
  </script>
{{/if}}
<form
  id='searchForm'
  class='search-form'
  action='/search.html'
  role='search'
  aria-label='Translate a word or phrase'
>
  <p class='search-form-languages'>
    <span class='clause'>I study
      <span class='language-selector'><span
          class='label-text'
          translate='no'
        ></span><svg class='chevron' viewBox='0 0 12 8' aria-hidden='true'><path
            d='M1.5 1.75 6 6.25l4.5-4.5'
          /></svg><vocably-filter-select
          variant='plain'
          label='Language I study'
        ><span slot='trigger'></span></vocably-filter-select><input
          type='hidden'
          name='sourceLanguage'
        /></span></span>
    <span class='clause'>I speak
      <span class='language-selector'><span
          class='label-text'
          translate='no'
        ></span><svg class='chevron' viewBox='0 0 12 8' aria-hidden='true'><path
            d='M1.5 1.75 6 6.25l4.5-4.5'
          /></svg><vocably-filter-select
          variant='plain'
          label='Language I speak'
        ><span slot='trigger'></span></vocably-filter-select><input
          type='hidden'
          name='targetLanguage'
        /></span></span>
  </p>
  <div class='search-input'>
    <input
      type='text'
      class='text-input'
      name='text'
      aria-label='Word or phrase to translate'
      autocomplete='off'
      autocorrect='off'
      autocapitalize='none'
      value='{{query}}'
    />
    <input type='hidden' name='isReversed' value='false' />
    <button type='submit' class='submit-button' aria-label='Search'><i
        class='bi bi-search'
        aria-hidden='true'
      ></i></button>
  </div>
  {{#unless query}}
    <div class='search-form-hint invisible' data-nosnippet>
      For example,
      <button
        type='button'
        data-search-source-example
        translate='no'
      >apple</button><span data-search-relevant-target>
        or
        <button
          type='button'
          data-search-target-example
          translate='no'
        >banana</button></span>.
    </div>
  {{/unless}}
</form>
