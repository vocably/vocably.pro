<style>
  .search-input {
    --border-radius: 3rem;
    --height: 4rem;

    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 2px solid rgba(var(--v-color-primary-rgb), 0.45);
    border-radius: var(--border-radius);
    height: var(--height);
    background: #fff;
    transition:
      box-shadow 0.25s ease,
      border-color 0.25s ease;
    box-shadow:
      0 0 0 6px rgba(var(--v-color-primary-rgb), 0.08),
      0 4px 8px -2px rgba(16, 24, 40, 0.08),
      0 18px 36px -10px rgba(var(--v-color-primary-rgb), 0.35);

    &:hover {
      border-color: rgba(var(--v-color-primary-rgb), 0.7);
      box-shadow:
        0 0 0 6px rgba(var(--v-color-primary-rgb), 0.12),
        0 6px 12px -2px rgba(16, 24, 40, 0.1),
        0 22px 44px -10px rgba(var(--v-color-primary-rgb), 0.45);
    }

    &:has(:focus) {
      border-color: var(--v-color-primary);
      box-shadow:
        0 0 0 6px rgba(var(--v-color-primary-rgb), 0.18),
        0 6px 12px -2px rgba(16, 24, 40, 0.1),
        0 22px 44px -10px rgba(var(--v-color-primary-rgb), 0.45);
    }

    .text-input {
      flex: 1;
      padding-left: 1.75rem;
      border: none;
      font-weight: 400;
      outline: none;
      background: none;
      position: relative;
      height: var(--height);
      min-width: 0;
    }

    .submit-button {
      --size: calc(var(--height) - 0.75rem);

      flex-shrink: 0;
      background: var(--v-color-primary);
      border: none;
      border-radius: 50%;
      width: var(--size);
      height: var(--size);
      margin-right: 0.3rem;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 1.15rem;
      transition:
        transform 0.15s ease,
        filter 0.15s ease;

      &:hover {
        filter: brightness(1.1);
        transform: scale(1.05);
      }

      &:focus-visible {
        outline: auto;
        outline-color: Highlight;
        outline-color: -webkit-focus-ring-color;
      }
    }

    @media (max-width: 600px) {
      gap: 0.1rem;

      .text-input {
        padding-left: 1.25rem;
      }

      .submit-button {
        --size: calc(var(--height) - 1rem);
        margin-right: 0.25rem;
      }
    }
  }

  .search-form-languages {
    margin: 0 0 1rem 1.75rem;
    font-size: 1.15rem;
    line-height: 1.6;
    text-align: left;
    transition: opacity 0.2s ease;

    /* Hidden (space still reserved) until the language selects are
       rendered; index.ts adds .ready. */
    &:not(.ready) {
      visibility: hidden;
      opacity: 0;
    }

    /* Each clause wraps as a whole, so "and I speak X" moves to the next
       line together rather than leaving the select dangling. */
    .clause {
      white-space: nowrap;
    }

    /* The label is plain text in the light DOM, so the line is laid out the
       same before, during and after the select's upgrade; the select's
       (empty) trigger button is stretched over it to handle the clicks. */
    .language-selector {
      position: relative;
      display: inline-block;
      vertical-align: top;
      font-weight: 600;
      color: var(--v-color-primary);

      vocably-filter-select {
        position: absolute;
        inset: 0 -0.25em;
        display: block;

        &::part(trigger) {
          border-radius: 0.25rem;
        }

        &::part(trigger):focus-visible {
          outline-offset: 0;
        }
      }

      .label-text {
        text-decoration: underline dashed;
        text-decoration-color: rgba(var(--v-color-primary-rgb), 0.55);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.3em;
        transition: text-decoration-color 0.2s ease;
      }

      .chevron {
        display: inline-block;
        width: 0.6em;
        height: 0.6em;
        margin-left: 0.3em;
        vertical-align: 0.05em;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.75;
        stroke-linecap: round;
        stroke-linejoin: round;
        transition: transform 0.2s ease;
      }

      &:hover .label-text {
        text-decoration-color: var(--v-color-primary);
      }

      &:hover .chevron {
        transform: translateY(1px);
      }

      &:has(vocably-filter-select.open) .chevron {
        transform: rotate(180deg);
      }
    }

    /* Small screens: a fixed two-row layout ("I study X" / "I speak Y")
       instead of a sentence wrapping wherever the language names push it.
       Always two rows, so the height doesn't depend on the names either. */
    @media (max-width: 600px) {
      margin-left: 1.25rem;
      font-size: 1rem;
      line-height: 1.75;

      .clause {
        display: block;
      }

      .conjunction {
        display: none;
      }
    }
  }

  .search-form-hint {
    margin-top: 0.5rem;
    margin-left: 1.8rem;
    margin-right: 1.8rem;
    font-size: 80%;
    text-align: right;

    button {
      font-size: inherit;
      background: none;
      border: none;
      cursor: pointer;
      padding: 0;
      margin: 0;
      color: inherit;
      font-weight: inherit;
      text-decoration: underline;
      text-decoration-style: dashed;
      text-decoration-thickness: 1px;
      text-underline-offset: 2px;
    }
  }
</style>
{{#if sourceLanguage}}
  <script type='text/javascript'>
    window['searchFormSourceLanguage'] = '{{sourceLanguage}}';
  </script>
{{/if}}
<form
  id='searchForm'
  class='search-form'
  action='/search.html'
  role='search'
  aria-label='Translate a word or phrase'
>
  <p class='search-form-languages'>
    <span class='clause'>I study
      <span class='language-selector'><span
          class='label-text'
          translate='no'
        ></span><svg class='chevron' viewBox='0 0 12 8' aria-hidden='true'><path
            d='M1.5 1.75 6 6.25l4.5-4.5'
          /></svg><vocably-filter-select
          variant='plain'
          label='Language I study'
        ><span slot='trigger'></span></vocably-filter-select><input
          type='hidden'
          name='sourceLanguage'
        /></span><span class='conjunction'>,</span></span>
    <span class='clause'><span class='conjunction'>and</span>
      I speak
      <span class='language-selector'><span
          class='label-text'
          translate='no'
        ></span><svg class='chevron' viewBox='0 0 12 8' aria-hidden='true'><path
            d='M1.5 1.75 6 6.25l4.5-4.5'
          /></svg><vocably-filter-select
          variant='plain'
          label='Language I speak'
        ><span slot='trigger'></span></vocably-filter-select><input
          type='hidden'
          name='targetLanguage'
        /></span><span class='too' hidden> too.</span></span>
  </p>
  <div class='search-input'>
    <input
      type='text'
      class='text-input'
      name='text'
      aria-label='Word or phrase to translate'
      autocomplete='off'
      autocorrect='off'
      autocapitalize='none'
      value='{{query}}'
    />
    <input type='hidden' name='isReversed' value='false' />
    <button type='submit' class='submit-button' aria-label='Search'><i
        class='bi bi-search'
        aria-hidden='true'
      ></i></button>
  </div>
  {{#unless query}}
    <div class='search-form-hint invisible' data-nosnippet>
      For example,
      <button
        type='button'
        data-search-source-example
        translate='no'
      >apple</button><span data-search-relevant-target>
        or
        <button
          type='button'
          data-search-target-example
          translate='no'
        >banana</button></span>.
    </div>
  {{/unless}}
</form>