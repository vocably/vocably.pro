<style>
  .search-input {
    --border-radius: 3rem;
    --height: 4rem;

    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 2px solid rgba(var(--v-color-primary-rgb), 0.45);
    border-radius: var(--border-radius);
    height: var(--height);
    background: #fff;
    transition:
      box-shadow 0.25s ease,
      border-color 0.25s ease;
    box-shadow:
      0 0 0 6px rgba(var(--v-color-primary-rgb), 0.08),
      0 4px 8px -2px rgba(16, 24, 40, 0.08),
      0 18px 36px -10px rgba(var(--v-color-primary-rgb), 0.35);

    &:hover {
      border-color: rgba(var(--v-color-primary-rgb), 0.7);
      box-shadow:
        0 0 0 6px rgba(var(--v-color-primary-rgb), 0.12),
        0 6px 12px -2px rgba(16, 24, 40, 0.1),
        0 22px 44px -10px rgba(var(--v-color-primary-rgb), 0.45);
    }

    &:has(:focus) {
      border-color: var(--v-color-primary);
      box-shadow:
        0 0 0 6px rgba(var(--v-color-primary-rgb), 0.18),
        0 6px 12px -2px rgba(16, 24, 40, 0.1),
        0 22px 44px -10px rgba(var(--v-color-primary-rgb), 0.45);
    }

    .language-selector-wrapper {
      padding: 0 1rem;
      font-size: 60%;
      font-weight: bold;
      color: var(--v-color-primary);

      &:first-child {
        border-radius: var(--border-radius) 0 0 var(--border-radius);
        padding-left: 1.5rem;
      }

      &:has(:focus) {
        outline: none;
      }

      &:has(:focus-visible) {
        outline: auto;
        outline-color: Highlight;
        outline-color: -webkit-focus-ring-color;
      }

      position: relative;

      .label {
        text-transform: uppercase;
        width: 2rem;
        text-align: center;
        height: var(--height);
        line-height: var(--height);
      }

      select {
        position: absolute;
        left: 0;
        top: 0;
        right: 0;
        bottom: 0;
        opacity: 0;
        appearance: none;
      }

      &.delimiter {
        border-right: 1px solid rgba(var(--v-color-primary-rgb), 0.3);
        padding-left: 1rem;
        margin-right: 1rem;
      }
    }

    .text-input {
      flex: 1;
      border: none;
      font-weight: 400;
      outline: none;
      background: none;
      position: relative;
      height: var(--height);
      min-width: 0;
    }

    .submit-button {
      --size: calc(var(--height) - 0.75rem);

      flex-shrink: 0;
      background: var(--v-color-primary);
      border: none;
      border-radius: 50%;
      width: var(--size);
      height: var(--size);
      margin-right: 0.3rem;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 1.15rem;
      transition:
        transform 0.15s ease,
        filter 0.15s ease;

      &:hover {
        filter: brightness(1.1);
        transform: scale(1.05);
      }

      &:focus-visible {
        outline: auto;
        outline-color: Highlight;
        outline-color: -webkit-focus-ring-color;
      }
    }

    @media (max-width: 600px) {
      gap: 0.1rem;

      .submit-button {
        --size: calc(var(--height) - 1rem);
        margin-right: 0.25rem;
      }

      .language-selector-wrapper {
        padding: 0 0.2rem;

        &.delimiter {
          padding-left: 0.4rem;
          margin-right: 0.4rem;
        }

        &:first-child {
          border-radius: var(--border-radius) 0 0 var(--border-radius);
          padding-left: 0.8rem;
        }
      }
    }
  }

  .search-form-hint {
    margin-top: 0.5rem;
    margin-left: 1.8rem;
    margin-right: 1.8rem;
    font-size: 80%;
    text-align: right;

    button {
      font-size: inherit;
      background: none;
      border: none;
      cursor: pointer;
      padding: 0;
      margin: 0;
      color: inherit;
      font-weight: inherit;
      text-decoration: underline;
      text-decoration-style: dashed;
      text-decoration-thickness: 1px;
      text-underline-offset: 2px;
    }
  }
</style>
{{#if sourceLanguage}}
  <script type='text/javascript'>
    window['searchFormSourceLanguage'] = '{{sourceLanguage}}';
  </script>
{{/if}}
<form
  id='searchForm'
  class='search-form'
  action='/search.html'
  role='search'
  aria-label='Translate a word or phrase'
>
  <div class='search-input'>
    <div class='language-selector-wrapper'>
      <div class='label' aria-hidden='true' translate='no'></div>
      <select name='sourceLanguage' aria-label='Source language'>
        {{#each htmlWebpackPlugin.options.environment.languages}}
          <option value='{{this.code}}'>{{this.label}}</option>
        {{/each}}
      </select>
    </div>
    <i class='bi bi-chevron-compact-right' aria-hidden='true'></i>
    <div class='language-selector-wrapper delimiter'>
      <div class='label' aria-hidden='true' translate='no'></div>
      <select name='targetLanguage' aria-label='Target language'>
        {{#each htmlWebpackPlugin.options.environment.languages}}
          <option value='{{this.code}}'>{{this.label}}</option>
        {{/each}}
      </select>
    </div>
    <input
      type='text'
      class='text-input'
      name='text'
      aria-label='Word or phrase to translate'
      autocomplete='off'
      autocorrect='off'
      autocapitalize='none'
      value='{{query}}'
    />
    <input type='hidden' name='isReversed' value='false' />
    <button type='submit' class='submit-button' aria-label='Search'><i
        class='bi bi-search'
        aria-hidden='true'
      ></i></button>
  </div>
  {{#unless query}}
    <div class='search-form-hint invisible' data-nosnippet>
      For example,
      <button
        type='button'
        data-search-source-example
        translate='no'
      >apple</button><span data-search-relevant-target>
        or
        <button
          type='button'
          data-search-target-example
          translate='no'
        >banana</button></span>.
    </div>
  {{/unless}}
</form>
