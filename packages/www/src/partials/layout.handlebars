<!doctype html>
<html lang="en" class="h-100">
  <head>
    <script>
      window.apiBaseUrl = '{{ htmlWebpackPlugin.options.environment.apiBaseUrl }}';
      window.publicApiBaseUrl = '{{ htmlWebpackPlugin.options.environment.publicApiBaseUrl }}';
      window.authUserPoolId = '{{ htmlWebpackPlugin.options.environment.authUserPoolId }}';
      window.authUserPoolWebClientId = '{{ htmlWebpackPlugin.options.environment.authUserPoolWebClientId }}';
      window.paddleClientSideToken = '{{ htmlWebpackPlugin.options.environment.paddleClientSideToken }}';
      window.paddleMonthlyPriceId = '{{ htmlWebpackPlugin.options.environment.paddleMonthlyPriceId }}';
      window.paddleYearlyPriceId = '{{ htmlWebpackPlugin.options.environment.paddleYearlyPriceId }}';
      window.paddleLifetimePriceId = '{{ htmlWebpackPlugin.options.environment.paddleLifetimePriceId }}';
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600&display=swap" rel="stylesheet">
    <title>{{#if title}}{{title}} | {{/if}}Vocably</title>
    <meta name="description" content="{{#if metaDescription}}{{metaDescription}}{{else}}Combination of contextual dictionary and flashcards. Select → Translate → Save → Learn. Supports Chrome, Safari, iOS, Android.{{/if}}" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="{{#if title}}{{title}} | {{/if}}Vocably" />
    <meta property="og:description" content="{{#if ogDescription}}{{ogDescription}}{{else}}Combination of contextual dictionary and flashcards. Select → Translate → Save → Learn.{{/if}}" />
    <meta property="og:url" content="{{htmlWebpackPlugin.options.environment.baseUrl}}{{url}}" />
    <meta property="og:image" content="{{htmlWebpackPlugin.options.environment.baseUrl}}/assets/og-images/{{#if ogImage}}{{ogImage}}{{else}}main.png{{/if}}" />
    <link rel="canonical" href="{{htmlWebpackPlugin.options.canonicalHref}}" />
    <meta name="apple-itunes-app" content="app-id=1641258757" />
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-element-bundle.min.js"></script>
    {{{_sections.manifest}}}
    <base href="/" />
    <style>
      .show-android,
      .hide-android,
      .show-ios,
      .hide-ios,
      .hide-chrome,
      .hide-safari,
      .show-chrome,
      .show-safari,
      .show-any,
      .show-other {
        visibility: hidden;
      }
    </style>
  </head>
  <body id="page-top" class="d-flex flex-column min-vh-100{{#unless hideNavBar}}{{#unless navbarContainerClass}} has-inline-navbar{{/unless}}{{/unless}}">
    <div>
      {{#unless disableAnalytics}}
        <script defer src="https://cloud.umami.is/script.js" data-website-id="{{ htmlWebpackPlugin.options.environment.umamiWebsiteId }}" data-auto-track="{{#if disabledAutoTrack}}false{{else}}true{{/if}}"></script>
      {{/unless}}
      {{#unless hideNavBar}}
        <style>
          .navbar-bg {
            background: linear-gradient(180deg, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.2) 100%);
            backdrop-filter: blur(10px);
          }

          @media (width >= 1280px) {
            .navbar-bg {
              background: none;
              backdrop-filter: none;
            }
          }

          .sticky-menu {
            position: sticky;
            top: 0;
            z-index: 1020;
          }

          .navbar-home-link {
            flex: 0 1 auto;
            align-self: self-start;
            margin-top: 4px;
          }

          .nav-logo {
            height: 1.6rem;
          }

          .navbar-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            width: 100%;
            margin: 0 auto;
          }

          /*
            On wide screens the full-width navbar wastes a whole band of vertical
            space: the logo sits far left, the CTA far right, and the page heading
            gets pushed below the empty middle.

            `.has-inline-navbar` (set when the navbar spans the full width) turns
            the body into a grid and puts the navbar and <main> into the same grid
            cell, so the logo and the CTA end up on the same level as the heading.

            The breakpoint is the narrowest width at which that is safe. The
            headings of these pages live in a centred container of at most 720px,
            while the navbar occupies 132px on the left (padding + logo) and 225px
            on the right (CTA + padding), so at 1280px the content still clears the
            CTA by ~55px. Below the breakpoint the navbar goes back to being a
            separate block above the content.
          */
          @media (width >= 1280px) {
            .has-inline-navbar {
              /* !important is required to beat Bootstrap's `.d-flex` utility */
              display: grid !important;
              grid-template-columns: 100%;
              grid-template-rows: 1fr auto;
            }

            .has-inline-navbar > nav,
            .has-inline-navbar > main {
              grid-row: 1;
              grid-column: 1;
            }

            .has-inline-navbar > nav {
              /* keeps the navbar at its natural height so `position: sticky` still
                 has room to travel inside the shared grid area */
              align-self: start;
              /* grid items honour z-index without being positioned */
              z-index: 1020;
              /* the navbar strip covers the top of the content, so only its own
                 controls may swallow clicks */
              pointer-events: none;
              /* nothing meaningful scrolls under the navbar here — the heading sits
                 next to it, not below it — so no murky backdrop */
              background: none;
              backdrop-filter: none;
            }

            .has-inline-navbar > nav .navbar-home-link,
            .has-inline-navbar > nav .get-button {
              pointer-events: auto;
            }

            /* line the heading up with the navbar controls instead of the very top
               of the viewport (matches the navbar's own vertical padding) */
            .has-inline-navbar > main {
              padding-top: 1rem;
            }
          }

          @media (width < 1280px) {
            .navbar {
              margin-bottom: 3rem;
            }

            .navbar-container {
              max-width: 720px;
            }
          }
        </style>
        <nav class="navbar navbar-expand-lg navbar-light{{#unless nonStickyNavbar}} sticky-menu sticky-top{{/unless}} navbar-bg px-4" style="">
          <div class="{{#if navbarContainerClass}}{{ navbarContainerClass }}{{else}}navbar-container{{/if}} p-0">
            <a class="navbar-home-link" href="/">
              <img
                src="assets/logo.svg"
                alt="Vocably"
                class="nav-logo"
              />
            </a>
            {{#unless noCta}}
              <div class="d-flex flex-column get-button">
                <a
                  href='https://chrome.google.com/webstore/detail/vocably/baocigmmhhdemijfjnjdidbkfgpgogmb'
                  class='show-chrome btn btn-primary btn-sm rounded-pill px-5 text-sm'
                  data-umami-event='CTA Click'
                  data-umami-event-label='Chrome Extension'
                >Get started</a>
                <a
                  href='https://apps.apple.com/app/id6464076425'
                  class='show-safari btn btn-primary btn-sm rounded-pill px-5 text-sm'
                  data-umami-event='CTA Click'
                  data-umami-event-label='Safari Extension'
                >Get started</a>
                <a
                  href='https://play.google.com/store/apps/details?id=com.vocablypro'
                  class='show-android btn btn-primary btn-sm rounded-pill px-5 text-sm'
                  data-umami-event='CTA Click'
                  data-umami-event-label='Android app'
                >Get started</a>
                <a
                  href='https://apps.apple.com/app/vocably-pro-language-cards/id1641258757'
                  class='show-ios btn btn-primary btn-sm rounded-pill px-5 text-sm'
                  data-umami-event='CTA Click'
                  data-umami-event-label='iOS app'
                >Get started</a>
              </div>
            {{/unless}}
          </div>
        </nav>
      {{/unless}}
      <main class="flex-shrink-0">
        {{> @partial-block }}
      </main>
    </div>

    <footer class="useful-links">
      <div class="container-md py-5" aria-label="Tools and ideas">
        <div style="margin-bottom: 3rem;">
          <a href="/"><img src="/assets/logo-dark.svg" alt="Vocably" style="height: 1em;opacity: 0.8"/></a>
        </div>
        <p class="h5">Language acquisition through real-life usage</p>
        <p>If you use your target language in everyday life, you will likely appreciate these tools and techniques:</p>
        <ul class="useful-links-list list-unstyled">
          {{#unless (eq url "/search.html")}}<li><i class="bi bi-translate" aria-hidden="true"></i><span><a href="/search.html">Online Dictionary</a> — a dictionary created specifically for language learners</span></li>{{/unless}}
          {{#unless (eq url "/grammar.html")}}<li><i class="bi bi-spellcheck" aria-hidden="true"></i><span><a href="/grammar.html">AI Grammar Checker</a> — the only checker that not only corrects your grammar, but also explains why</span></li>{{/unless}}
          {{#unless (eq url "/ai.html")}}<li><i class="bi bi-openai" aria-hidden="true"></i><span><a href="/ai.html">How to Use AI as a Language Learner</a> — a 3-step guide to turning ChatGPT, Gemini, or Claude into a language-learning companion</span></li>{{/unless}}
        </ul>
      </div>
    </footer>

