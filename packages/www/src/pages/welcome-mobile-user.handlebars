{{#> layout
  title='Getting started with Vocably'
  url='/welcome-mobile-user.html'
}}
  <section class="ise-hero container-lg text-center">
    <span class="ise-eyebrow"><i class="bi bi-phone" aria-hidden="true"></i> Getting started</span>
    <h1 class="ise-title">Welcome to Vocably</h1>
    <p class="ise-lead">
      Vocably is a dictionary and flashcards in one app. Look up the words you
      come across, save the ones you want to remember, and practice them for a
      few minutes a day.
    </p>

    <ul class="wmu-overview">
      <li>
        <i class="bi bi-translate" aria-hidden="true"></i>
        <h2>Look up</h2>
        <p>See translations, pronunciation, and examples for any word or phrase.</p>
      </li>
      <li>
        <i class="bi bi-plus-circle" aria-hidden="true"></i>
        <h2>Save</h2>
        <p>Add the words you want to remember to your cards with one tap.</p>
      </li>
      <li>
        <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
        <h2>Practice</h2>
        <p>Spaced repetition brings each word back right before you’d forget it.</p>
      </li>
    </ul>

    <div class="ise-note wmu-safari-note hide-android">
      <i class="bi bi-apple" aria-hidden="true"></i>
      <p>
        On iPhone, Vocably also works in Safari: select a word on any web page
        to translate it. <a href="/ios-safari-extension.html">Set up Vocably for Safari</a>
      </p>
    </div>
  </section>

  <section class="container-lg">
    <h2 class="wmu-section-title">Build your word list</h2>

    <ol class="ise-steps">
      <li class="ise-step">
        <div class="ise-step-body">
          <span class="ise-step-number" aria-hidden="true">1</span>
          <h2>Open the Look up tab</h2>
          <p>
            The first time you open Vocably, your card list is empty. Tap
            <strong>Look up</strong> at the bottom of the screen to find your
            first word.
          </p>
        </div>
        <figure class="ise-step-media">
          <img src="assets/welcome/look-up-tab.png" class="wmu-shot" width="1300" height="1540" alt="The Look up tab at the bottom of the Vocably app." loading="lazy" />
        </figure>
      </li>

      <li class="ise-step">
        <div class="ise-step-body">
          <span class="ise-step-number" aria-hidden="true">2</span>
          <h2>Choose your languages</h2>
          <p>
            At the top of the screen, tap the left button to pick the language
            you’re learning, and the right button to pick a language you
            already know.
          </p>
          <p class="ise-hint">
            In these screenshots, the learner studies Dutch and already speaks
            English.
          </p>
        </div>
        <figure class="ise-step-media">
          <img src="assets/welcome/language-selected.png" class="wmu-shot" width="1300" height="1540" alt="The language buttons: Dutch on the left, English on the right." loading="lazy" />
        </figure>
      </li>

      <li class="ise-step">
        <div class="ise-step-body">
          <span class="ise-step-number" aria-hidden="true">3</span>
          <h2>Translate a word you came across</h2>
          <p>
            Type the word in the search field and tap
            <i class="bi bi-search" aria-label="search"></i>. Vocably shows its
            translations, pronunciation, and examples.
          </p>
          <p>
            Tap <i class="bi bi-plus-circle-fill wmu-icon" aria-label="plus"></i>
            to add the word to your cards.
          </p>
          <div class="ise-note">
            <i class="bi bi-lightning-charge" aria-hidden="true"></i>
            <div>
              <p class="hide-ios">
                <strong>On Android</strong>, you can select a word in any app
                and translate it with Vocably.
                <a href="https://www.youtube.com/watch?v=jNNurc9w7AY&t=9s" target="_blank">Watch how</a>
              </p>
              <p class="hide-android">
                <strong>On iPhone</strong>, you can translate words in Safari
                with <a href="/ios-safari-extension.html" target="_blank">Vocably for Safari</a>.
              </p>
            </div>
          </div>
        </div>
        <figure class="ise-step-media">
          <img src="assets/welcome/translate-new-word.png" class="wmu-shot" width="1300" height="1540" alt="A Dutch word typed in the search field, with its translation and the add button." loading="lazy" />
        </figure>
      </li>

      <li class="ise-step" id="reverse-translation">
        <div class="ise-step-body">
          <span class="ise-step-number" aria-hidden="true">4</span>
          <h2>Find the word you want to say</h2>
          <p>
            Don’t know how to say something in the language you’re learning?
            Tap the arrow between the two languages to switch the direction,
            then type the word in the language you know.
          </p>
          <p>
            Pick the best match and tap
            <i class="bi bi-plus-circle-fill wmu-icon" aria-label="plus"></i>
            to save it.
          </p>
        </div>
        <figure class="ise-step-media">
          <img src="assets/welcome/reverse-translation.png" class="wmu-shot" width="1300" height="1738" alt="Reverse translation: an English phrase typed in, with Dutch words in the results." loading="lazy" />
        </figure>
      </li>
    </ol>

    <h2 class="wmu-section-title">Learn your words</h2>

    <ol class="ise-steps">
      <li class="ise-step">
        <div class="ise-step-body">
          <span class="ise-step-number" aria-hidden="true">5</span>
          <h2>Start a practice session</h2>
          <p>
            Once you’ve saved a few words, open the <strong>Cards</strong> tab
            and tap <strong>Practice</strong>.
          </p>
        </div>
        <figure class="ise-step-media">
          <img src="assets/welcome/cards-tab.png" class="wmu-shot" width="1300" height="1540" alt="The Cards tab with saved words and the Practice button." loading="lazy" />
        </figure>
      </li>

      <li class="ise-step">
        <div class="ise-step-body">
          <span class="ise-step-number" aria-hidden="true">6</span>
          <h2>Swipe to answer</h2>
          <p>
            Each card shows a word. Try to recall what it means. If you can’t,
            tap the card to see the translation.
          </p>
          <ul class="ise-checklist">
            <li><i class="bi bi-arrow-right-circle-fill" aria-hidden="true"></i> <span><strong>Swipe right</strong> if you remembered it. You’ll see it less often.</span></li>
            <li><i class="bi bi-arrow-left-circle-fill" aria-hidden="true"></i> <span><strong>Swipe left</strong> if you didn’t. Vocably will show it again sooner.</span></li>
          </ul>
          <p class="ise-hint">
            This is spaced repetition: each word comes back just before you’re
            likely to forget it, so your practice time goes to the words that
            need it most.
          </p>
        </div>
        <div class="ise-step-media ise-step-media-pair">
          <figure>
            <video loop autoplay muted playsinline controls class="ise-phone" width="886" height="1798">
              <source src="assets/welcome/swipe-right.mp4" type="video/mp4" />
            </video>
            <figcaption>I remember</figcaption>
          </figure>
          <figure>
            <video loop autoplay muted playsinline controls class="ise-phone" width="886" height="1794">
              <source src="assets/welcome/swipe-left.mp4" type="video/mp4" />
            </video>
            <figcaption>Not yet</figcaption>
          </figure>
        </div>
      </li>
    </ol>
  </section>

  <section class="container-lg ise-help-section">
    <div class="ise-help">
      <i class="bi bi-envelope-heart" aria-hidden="true"></i>
      <div>
        <h2>Have a question?</h2>
        <p>
          Write to me at <a href="mailto:d@vocably.pro">d@vocably.pro</a>.
          I read and answer every email.
        </p>
      </div>
    </div>
  </section>
{{/layout}}
