PHP_ARRAY_TO_URLENCODE_DATA_FILE="example.txt"
USERNAME="test_dev"
USER_POOL_ID="eu-central-1_g0OM2BVPL"
AWS_REGION="eu-central-1"
ENDTEST_APP_ID="51386087"
ENDTEST_APP_CODE="Provided by CI"
ENDTEST_LATEST_ENV_SUITE="544592"
DECKS_BUCKET="vocably-dev-cards"
HEMMINGWAY_API_KEY="to-be-provided"

# App Store Connect API key with the App Manager or Admin role, used by
# upload-app-store-screenshots.mts. Put the real values in .env.local.
APP_STORE_CONNECT_API_KEY_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_KEY_ID=
# The .p8 file contents, base64-encoded: base64 -i AuthKey_XXXXXXXXXX.p8
APP_STORE_CONNECT_API_KEY_KEY=

APP_STORE_CONNECT_FINANCIAL_API_KEY_KEY_ID=
# The .p8 file contents, base64-encoded: base64 -i AuthKey_XXXXXXXXXX.p8
APP_STORE_CONNECT_FINANCIAL_API_KEY_KEY=

#1. Create the service account (Google Cloud Console)
#1. Open https://console.cloud.google.com and pick a project, or create one such as vocably-play.
#2. Go to APIs & Services → Library, search for Google Play Android Developer API, and click Enable.
#3. Go to IAM & Admin → Service Accounts → Create service account.
#   - Give it a name, such as play-store-uploader.
#   - Skip the optional "Grant this service account access to project" step. It doesn't need any Cloud roles.
#4. Open the new service account, go to the Keys tab, and click Add key → Create new key → JSON. A .json file downloads.
#5. Copy the account's email (play-store-uploader@<project>.iam.gserviceaccount.com). You'll need it in step 2.
#
#If key creation is blocked by an organization policy (iam.disableServiceAccountKeyCreation), an org admin has to allow it for this project.
#
#2. Give it access in Play Console
#1. Open https://play.google.com/console and go to Users and permissions → Invite new users.
#2. Paste the service account email.
#3. Under App permissions, add Vocably (com.vocablypro) and tick Store presence → Manage store presence. That's all the screenshot script needs.
#4. Click Invite user. Service accounts are added straight away, with no acceptance email.
#
#It can take a while before the API accepts the new permission. Until then the script fails with 401 or 403 errors, so if the first run fails that way, wait and try again.
#
#3. Put the key in scripts/.env.local
#echo "GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=$(base64 -i ~/Downloads/<key-file>.json)" >> scripts/.env.local
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=

APP_STORE_VENDOR_NUMBER=...
INVOICE_SELLER_NAME=...
INVOICE_SELLER_ADDRESS=Street 1\nCity, ZIP\nCountry
INVOICE_SELLER_TAX_ID=...                         # optional
INVOICE_SELLER_BANK=Bank name\nIBAN ...\nSWIFT ...  # optional
INVOICE_SELLER_EMAIL=...
