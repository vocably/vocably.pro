# SEO search pages: /<source>-<target>/<word>-in-<language>.html, e.g.
# /de-en/apple-in-german.html.
#
# The pages are rendered on demand by the seo-render lambda from the search
# page template and the search data of the requested word, which it reads from
# the SEO bucket on every request. The data comes from
# packages/www/seo/search-data/<pair>.json (one file per language pair,
# generated by scripts/build-seo-search-data.mts), which
# scripts/seo-upload-search-data.mts syncs to the bucket as one object per
# page. Both only change with a deploy, and www_upload invalidates "/*" after
# uploading them, so CloudFront can keep the pages until then.

locals {
  seo_backend_root     = abspath("../packages/seo-backend")
  seo_bucket           = "vocably-${terraform.workspace}-seo-pages"
  seo_search_data_root = "${local.www_root}/seo/search-data"

  seo_language_pairs = toset([
    for file in fileset(local.seo_search_data_root, "*.json") :
    trimsuffix(file, ".json")
  ])
}

data "external" "seo_backend_build" {
  # Chained after the www build so the builds don't compete for memory.
  depends_on = [data.external.www_build]
  program = ["bash", "-lc", <<EOT
(NODE_OPTIONS=--max-old-space-size=1024 npm run build --loglevel verbose) >&2 && echo "{\"dest\": \"dist\"}"
EOT
  ]
  working_dir = local.seo_backend_root
}

data "archive_file" "seo_backend_build" {
  depends_on  = [data.external.seo_backend_build]
  type        = "zip"
  source_dir  = "${data.external.seo_backend_build.working_dir}/${data.external.seo_backend_build.result.dest}"
  output_path = "seo_backend_build.zip"
}

# Holds nothing but copies of files from the repository, so it can be removed
# at any time: force_destroy lets Terraform delete it with its objects, and
# without versioning there are no old versions left behind to block that.
resource "aws_s3_bucket" "seo" {
  bucket        = local.seo_bucket
  force_destroy = true
}

resource "aws_s3_bucket_versioning" "seo" {
  bucket = aws_s3_bucket.seo.id

  versioning_configuration {
    # "Disabled" is only accepted for a bucket that never had versioning,
    # which is the case for this one.
    status = "Disabled"
  }
}

resource "aws_s3_bucket_public_access_block" "seo" {
  bucket = aws_s3_bucket.seo.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "null_resource" "seo_search_data_upload" {
  for_each = local.seo_language_pairs

  depends_on = [aws_s3_bucket.seo]

  triggers = {
    data   = filemd5("${local.seo_search_data_root}/${each.key}.json")
    bucket = aws_s3_bucket.seo.bucket
  }

  # Uploads only the pages whose data changed and deletes the ones of removed
  # words.
  provisioner "local-exec" {
    command = "npx vite-node ${local.scripts_root}/seo-upload-search-data.mts ${each.key}"
    environment = {
      SEO_BUCKET = aws_s3_bucket.seo.bucket
      AWS_REGION = aws_s3_bucket.seo.region
    }
  }
}

resource "aws_iam_role" "seo_render_lambda" {
  name = "vocably-${terraform.workspace}-seo-render-lambda"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Action    = "sts:AssumeRole"
      Effect    = "Allow"
      Principal = { Service = "lambda.amazonaws.com" }
    }]
  })
}

resource "aws_iam_role_policy" "seo_render_lambda" {
  name = "vocably-${terraform.workspace}-seo-render-lambda"
  role = aws_iam_role.seo_render_lambda.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid      = "Logging"
        Effect   = "Allow"
        Action   = ["logs:CreateLogStream", "logs:PutLogEvents"]
        Resource = "${aws_cloudwatch_log_group.seo_render.arn}:*"
      },
      {
        Sid    = "ReadSearchData"
        Effect = "Allow"
        # ListBucket turns a missing word into a 404 instead of a 403.
        Action   = ["s3:GetObject", "s3:ListBucket"]
        Resource = [aws_s3_bucket.seo.arn, "${aws_s3_bucket.seo.arn}/*"]
      },
      {
        Sid      = "ReadTemplate"
        Effect   = "Allow"
        Action   = ["s3:GetObject"]
        Resource = ["${aws_s3_bucket.www.arn}/search.html"]
      },
    ]
  })
}

resource "aws_cloudwatch_log_group" "seo_render" {
  name              = "/aws/lambda/vocably-${terraform.workspace}-seo-render"
  retention_in_days = 14
}

resource "aws_lambda_function" "seo_render" {
  depends_on = [aws_cloudwatch_log_group.seo_render]

  filename         = data.archive_file.seo_backend_build.output_path
  function_name    = "vocably-${terraform.workspace}-seo-render"
  role             = aws_iam_role.seo_render_lambda.arn
  handler          = "render.handler"
  source_code_hash = data.archive_file.seo_backend_build.output_base64sha256
  runtime          = "nodejs22.x"
  # Rendering is CPU-bound, and CPU scales with memory.
  memory_size = 1024
  timeout     = 20

  environment {
    variables = {
      SEO_BUCKET = aws_s3_bucket.seo.bucket
      WWW_BUCKET = aws_s3_bucket.www.bucket
    }
  }
}

# Only CloudFront can call the URL: it signs its requests through the origin
# access control below.
resource "aws_lambda_function_url" "seo_render" {
  function_name      = aws_lambda_function.seo_render.function_name
  authorization_type = "AWS_IAM"
}

resource "aws_cloudfront_origin_access_control" "seo_render" {
  name                              = "vocably-${terraform.workspace}-seo-render"
  description                       = "CloudFront access to the SEO page renderer"
  origin_access_control_origin_type = "lambda"
  signing_behavior                  = "always"
  signing_protocol                  = "sigv4"
}

resource "aws_lambda_permission" "seo_render_cloudfront_url" {
  statement_id           = "AllowCloudFrontInvokeFunctionUrl"
  action                 = "lambda:InvokeFunctionUrl"
  function_name          = aws_lambda_function.seo_render.function_name
  principal              = "cloudfront.amazonaws.com"
  source_arn             = aws_cloudfront_distribution.www.arn
  function_url_auth_type = "AWS_IAM"
}

# Function URLs created since October 2025 also need lambda:InvokeFunction.
resource "aws_lambda_permission" "seo_render_cloudfront_invoke" {
  statement_id             = "AllowCloudFrontInvokeFunction"
  action                   = "lambda:InvokeFunction"
  function_name            = aws_lambda_function.seo_render.function_name
  principal                = "cloudfront.amazonaws.com"
  source_arn               = aws_cloudfront_distribution.www.arn
  invoked_via_function_url = true
}

# Keeps a container warm, so visitors rarely hit a cold start. The handler
# recognizes the warmUp input and only loads the template.
resource "aws_cloudwatch_event_rule" "seo_render_warm_up" {
  name                = "vocably-${terraform.workspace}-seo-render-warm-up"
  schedule_expression = "rate(5 minutes)"
}

resource "aws_cloudwatch_event_target" "seo_render_warm_up" {
  arn   = aws_lambda_function.seo_render.arn
  rule  = aws_cloudwatch_event_rule.seo_render_warm_up.name
  input = jsonencode({ warmUp = true })
}

resource "aws_lambda_permission" "seo_render_warm_up" {
  statement_id  = "AllowExecutionFromEventBridge"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.seo_render.function_name
  principal     = "events.amazonaws.com"
  source_arn    = aws_cloudwatch_event_rule.seo_render_warm_up.arn
}

locals {
  seo_render_origin_domain = trimsuffix(trimprefix(aws_lambda_function_url.seo_render.function_url, "https://"), "/")
}
